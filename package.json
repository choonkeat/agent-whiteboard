{
  "name": "@choonkeat/agent-whiteboard",
  "version": "0.3.0",
  "description": "Turtle-graphics-inspired animated whiteboard for AI agents with hand-drawn aesthetics",
  "type": "module",
  "main": "./dist/agent-whiteboard.umd.cjs",
  "module": "./dist/agent-whiteboard.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/agent-whiteboard.js",
      "require": "./dist/agent-whiteboard.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "agent-whiteboard": "bin/agent-whiteboard.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.dropin.config.ts",
    "build:lib": "vite build",
    "build:dropin": "vite build --config vite.dropin.config.ts",
    "build:mcp-client": "vite build --config vite.mcp-client.config.ts",
    "build:all": "npm run build && npm run build:mcp-client",
    "prepublishOnly": "npm run build:all"
  },
  "keywords": [
    "whiteboard",
    "agent",
    "turtle-graphics",
    "canvas",
    "rough.js",
    "animation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/choonkeat/agent-whiteboard.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.2.0",
    "terser": "^5.46.0",
    "typescript": "^5.3.3",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0"
  },
  "optionalDependencies": {
    "@choonkeat/agent-whiteboard-linux-x64": "0.2.0",
    "@choonkeat/agent-whiteboard-linux-arm64": "0.2.0",
    "@choonkeat/agent-whiteboard-darwin-x64": "0.2.0",
    "@choonkeat/agent-whiteboard-darwin-arm64": "0.2.0",
    "@choonkeat/agent-whiteboard-win32-x64": "0.2.0",
    "@choonkeat/agent-whiteboard-win32-arm64": "0.2.0"
  },
  "dependencies": {
    "roughjs": "^4.6.6"
  }
}
